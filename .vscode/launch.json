            "program": "${workspaceFolder}/build/exec/exec",
            "cwd": "${workspaceFolder}/build/exec",
            "preLaunchTask": "Build Exec"
        },
        {
            "name": "Unit Tests Debug",
            "type": "cuda-gdb",
