        {
            "name": "Accuracy tests",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/accuracy_tests/accuracy_tests",
            "cwd": "${workspaceFolder}/build/accuracy_tests",
            "preLaunchTask": "Build accuracy tests"
        }
    ]
}