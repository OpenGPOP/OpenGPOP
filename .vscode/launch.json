{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GPU Debug",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/exec/exec",
            "cwd": "${workspaceFolder}/build-debug/exec",
            "preLaunchTask": "Build Exec",
            "args": [
                "closest-approach",
                "--input",
                "${workspaceFolder}/data/col_data.json",
                "--output",
                "${workspaceFolder}/out.json"
            ],
        },
        {
            "name": "Unit Tests Debug",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/unit_tests/unit_tests",
            "cwd": "${workspaceFolder}/build-debug/unit_tests",
            "preLaunchTask": "Build Unit Tests"
        },
    ]
}