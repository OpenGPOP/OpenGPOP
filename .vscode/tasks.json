{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Unit Tests",
            "type": "shell",
            "command": "ninja unit_tests",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Exec",
            "type": "shell",
            "command": "ninja exec",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake --preset build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Clean Build",
            "type": "shell",
            "command": "rm -rf build && cmake --preset build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build accuracy tests",
            "type": "shell",
            "command": "ninja accuracy_tests",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}