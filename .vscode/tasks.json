{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Unit Tests",
            "type": "shell",
            "command": "ninja unit_tests",
            "options": {
                "cwd": "${workspaceFolder}/build-debug"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Exec",
            "type": "shell",
            "command": "ninja exec",
            "options": {
                "cwd": "${workspaceFolder}/build-debug"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake --preset debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Clean Build",
            "type": "shell",
            "command": "rm -rf build-debug && cmake --preset debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
    ]
}