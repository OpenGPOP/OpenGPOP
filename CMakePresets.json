{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "build-cpu-only",
            "inherits": "build",
            "cacheVariables": {
                "CPU_ONLY": true
            }
        }
    ]
}